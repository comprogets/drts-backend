# Copy this file to .env and fill it in before running the server.

# Port the server listens on.
PORT=4000

# Shared secret the frontend must send as the "x-api-key" header on every request.
# Generate a long random string, e.g. `openssl rand -hex 32`. Leaving this blank
# leaves the API open to anyone who can reach it — fine for local testing only.
API_KEY=change-me-to-a-long-random-string

# Comma-separated list of origins allowed to call this API (your frontend's URL).
# Use * only for local testing.
ALLOWED_ORIGIN=*
